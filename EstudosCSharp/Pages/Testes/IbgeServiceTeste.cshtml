@page
@model EstudosCSharp.Pages.Testes.IbgeServiceTesteModel

@{
    ViewData["Title"] = "Teste IbgeService";
}

<h1>Teste do IbgeService</h1>

<hr />

@if (Model.Erro is not null) {
    <p class="text-danger">
        Erro: @Model.Erro
    </p>
} else {
    <p>Total de Estados: @Model.TotalEstados</p>

    <p>
        Estado localizado:
        @Model.MatoGrosso?.Nome
    </p>

    <p>UF: @Model.MatoGrosso?.UF</p>

    <p>IBGE: @Model.MatoGrosso?.CodigoIbge</p>

    <p>Código 99 rejeitado: @Model.CodigoInvalido</p>

    <p>Estado válido: @Model.EstadoValido</p>

    <p>
        Estado inconsistente rejeitado:
        @Model.EstadoInvalido
    </p>

    <hr />

    <h2>Desempenho</h2>

    <p>
        Primeira consulta:
        @Model.TempoPrimeiraConsulta ms
    </p>

    <p>
        Segunda consulta:
        @Model.TempoSegundaConsulta ms
    </p>
}