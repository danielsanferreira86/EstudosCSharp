@page
@model EstudosCSharp.Pages.TesteModelsModel

@{
    ViewData["Title"] = "Teste das Models";
}

<div class="container mt-4">

    <h2>Teste das Models</h2>

    <p>Validação dos relacionamentos entre objetos.</p>

    <div class="card">

        <div class="card-header">
            Dados do Cliente
        </div>

        <div class="card-body">

            <p>
                <strong>Nome:</strong>
                @Model.ClienteTeste.Nome
            </p>

            <p>
                <strong>CPF:</strong>
                @Model.ClienteTeste.CPF
            </p>

            <p>
                <strong>Cidade:</strong>
                @(Model.ClienteTeste.Cidade?.Nome)
            </p>

            <p>
                <strong>Código IBGE:</strong>
                @(Model.ClienteTeste.Cidade?.Codigo_IBGE)
            </p>

            <p>
                <strong>Estado:</strong>
                @(Model.ClienteTeste.Cidade?.Estado?.Nome)
            </p>

            <p>
                <strong>UF:</strong>
                @(Model.ClienteTeste.Cidade?.Estado?.UF)
            </p>

        </div>

    </div>

</div>