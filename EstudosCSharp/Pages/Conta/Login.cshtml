@page
@model EstudosCSharp.Pages.Conta.LoginModel

@{
    ViewData["Title"] = "Autenticação";
    Layout = "_LayoutLogin";
}

<div class="login-container">

    <section class="login-panel">

        <div class="login-content">

            <div class="login-brand">
                <img src="~/images/autocore-logo.png"
                     asp-append-version="true"
                     alt="AutoCore-DMS"
                     class="login-logo" />
            </div>

            <div class="login-header">
                <h1>Bem-vindo!</h1>

                <p>
                    Informe suas credenciais para acessar o sistema.
                </p>
            </div>

            <form method="post" class="login-form">

                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly"
                     class="login-validation">
                </div>

                <div class="login-field">

                    <label asp-for="Credenciais.Login">
                        Usuário
                    </label>

                    <input asp-for="Credenciais.Login"
                           class="login-input"
                           placeholder="Informe seu usuário"
                           autocomplete="username" />

                    <span asp-validation-for="Credenciais.Login"
                          class="login-validation">
                    </span>

                </div>

                <div class="login-field">

                    <label asp-for="Credenciais.Senha">
                        Senha
                    </label>

                    <input asp-for="Credenciais.Senha"
                           type="password"
                           class="login-input"
                           placeholder="Informe sua senha"
                           autocomplete="current-password" />

                    <span asp-validation-for="Credenciais.Senha"
                          class="login-validation">
                    </span>

                </div>

                <button type="submit" class="login-button">
                    Acessar sistema
                </button>

            </form>

            <footer class="login-footer">
                AutoCore-DMS &copy; @DateTime.Now.Year
                <br />
                Todos os direitos reservados.
            </footer>

        </div>

    </section>

    <aside class="login-visual">

        <div class="login-visual-content">

            <h2>Gestão. Tecnologia. Performance.</h2>

            <p>
                Uma nova experiência em gestão automotiva.
            </p>

        </div>

    </aside>

</div>