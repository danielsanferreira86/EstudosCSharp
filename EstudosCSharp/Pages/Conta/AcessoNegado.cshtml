@page
@model EstudosCSharp.Pages.Conta.AcessoNegadoModel

@{
    ViewData["Title"] = "Acesso Negado";

    Layout = "_LayoutLogin";
}

<div class="login-panel">

    <div class="login-content text-center">

        <div class="display-3 mb-3">
            🔒
        </div>

        <h1 class="text-danger">
            Acesso negado
        </h1>

        <h2 class="h5 mt-3">
            Você não possui permissão
        </h2>

        <p class="login-message mt-3">
            Seu perfil de usuário não permite
            acessar esta funcionalidade.
        </p>

        <p class="login-message">
            Entre em contato com o administrador
            do sistema.
        </p>

        <a asp-page="/Index"
           class="btn login-button w-100 mt-3">
            Voltar ao início
        </a>

        <form method="post"
              asp-page="/Conta/Logout"
              class="mt-3">

            <button type="submit"
                    class="btn btn-outline-secondary w-100">
                Sair do sistema
            </button>

        </form>

        <hr />

        <div class="login-footer">
            AutoCore-DMS • Erro 403
        </div>

    </div>

</div>
<style>
.login-message { color: var(--color-text-secondary); }
a.login-button { display: inline-flex; align-items: center; justify-content: center; text-decoration: none; }
</style>
