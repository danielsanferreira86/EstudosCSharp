@page
@model EstudosCSharp.Pages.TesteConexaoModel

@{
    ViewData["Title"] = "Teste de Conexão";
}

<div class="container mt-5">

    <h2>Loja de Calçados</h2>

    <p>Teste de comunicação com o SQL Server.</p>

    <hr />

    @if (Model.Sucesso) {
        <div class="alert alert-success">
            @Model.Mensagem
        </div>
    } else {
        <div class="alert alert-danger">
            @Model.Mensagem
        </div>
    }

</div>