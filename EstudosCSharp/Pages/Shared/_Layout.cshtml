<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - AutoCore-DMS
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/layout.css"
          asp-append-version="true" />

</head>

<body>

    <div class="app-container">

        <partial name="_Header" />

        <div class="app-body">

            <partial name="_Sidebar" />

            <div class="sidebar-overlay"
                 id="sidebarOverlay">
            </div>

            <div class="app-content">

                <main class="app-main">

                    @RenderBody()

                </main>

                <partial name="_Footer" />

            </div>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/layout.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
    "Scripts", required: false)

</body>

</html>