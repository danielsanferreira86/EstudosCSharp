@using EstudosCSharp.Security
@using Microsoft.AspNetCore.Authorization

@inject IAuthorizationService AuthorizationService

@{
    var podeConsultarEstados =
        (await AuthorizationService.AuthorizeAsync(
            User,
            Permissoes.ConsultarEstados)).Succeeded;

    var podeConsultarCidades =
        (await AuthorizationService.AuthorizeAsync(
            User,
            Permissoes.ConsultarCidades)).Succeeded;

    var podeGerenciarUsuarios =
        (await AuthorizationService.AuthorizeAsync(
            User,
            Permissoes.GerenciarUsuarios)).Succeeded;

    var podeAlterarSenha =
        (await AuthorizationService.AuthorizeAsync(
            User,
            Permissoes.AlterarPropriaSenha)).Succeeded;

    var paginaAtual =
        ViewContext.RouteData.Values["page"]?.ToString()
        ?? string.Empty;

    bool MenuAtivo(string caminho) {
        caminho = caminho.TrimEnd('/');

        return paginaAtual.Equals(
                   caminho,
                   StringComparison.OrdinalIgnoreCase)

               || paginaAtual.StartsWith(
                   caminho + "/",
                   StringComparison.OrdinalIgnoreCase);
    }

    // CONTROLE DOS MÓDULOS

    var estadosAtivo =
        MenuAtivo("/Cadastros/Estados");

    var cadastrosAtivo =
        MenuAtivo("/Cadastros");
}

<aside class="app-sidebar" id="appSidebar">

    <nav class="sidebar-nav"
         aria-label="Menu principal">

        <div class="menu-title">
            Principal
        </div>

        <a asp-page="/Index"
           class="menu-item @(paginaAtual == "/Index"
                          ? "active" : "")">

            <span class="menu-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10 12 3l9 7v10H3z M9 20v-7h6v7" /></svg></span>

            <span>Dashboard</span>

        </a>

        <div class="menu-title">
            Cadastros
        </div>

        @if (podeConsultarEstados) {
            <a asp-page="/Cadastros/Estados/Index"
               class="menu-item @(paginaAtual.StartsWith("/Cadastros/Estados",
                          StringComparison.OrdinalIgnoreCase)
                          ? "active" : "")">

            <span class="menu-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5l6-2 6 2 6-2v16l-6 2-6-2-6 2z M9 3v16 M15 5v16" /></svg>
            </span>

                <span>Estados</span>

            </a>
          }

        @if (podeConsultarCidades) {
            <span class="menu-item disabled"
                  aria-disabled="true">

                <span class="menu-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0z M12 7a3 3 0 1 0 0 6 3 3 0 0 0 0-6" /></svg></span>

                <span>Cidades</span>

            </span>
        }

        <span class="menu-item disabled"
              aria-disabled="true">

            <span class="menu-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-3a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v3 M9 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8 M17 4a4 4 0 0 1 0 7 M22 21v-3a4 4 0 0 0-3-4" /></svg></span>

            <span>Clientes</span>

        </span>

        <span class="menu-item disabled"
              aria-disabled="true">

            <span class="menu-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 16v-5l3-6h12l3 6v5H3z M3 16v3 M21 16v3 M3 11h18 M7 14h1 M16 14h1" /></svg></span>

            <span>Veículos</span>

        </span>

        @if (podeGerenciarUsuarios) {
            <div class="menu-title">
                Administração
            </div>

            <span class="menu-item disabled"
                  aria-disabled="true">

                <span class="menu-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 3 6v6c0 5 9 10 9 10s9-5 9-10V6z M8 12l3 3 5-6" /></svg></span>

                <span>Usuários</span>

            </span>
        }

        <div class="menu-title">
            Minha conta
        </div>

        @if (podeAlterarSenha) {
            <span class="menu-item disabled"
                  aria-disabled="true">

                <span class="menu-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3a6 6 0 1 0 0 12 6 6 0 0 0 0-12 M11 13 3 21 M5 19l2 2" /></svg></span>

                <span>Alterar senha</span>

            </span>
        }

        <form method="post"
              asp-page="/Conta/Logout">

            <button type="submit"
                    class="menu-item menu-logout">

                <span class="menu-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3H3v18h7 M9 12h12 M17 8l4 4-4 4" /></svg></span>

                <span>Sair do sistema</span>

            </button>

        </form>

    </nav>

</aside>