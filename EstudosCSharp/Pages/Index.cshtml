@page
@model EstudosCSharp.Pages.IndexModel

@using EstudosCSharp.Security
@using Microsoft.AspNetCore.Authorization

@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Dashboard";

    var podeGerenciarUsuarios =
        (await AuthorizationService.AuthorizeAsync(
            User,
            Permissoes.GerenciarUsuarios)).Succeeded;
}

<h1 class="page-title">
    Dashboard
</h1>

<p class="page-subtitle">

    Bem-vindo, @Model.NomeUsuario!

</p>

<div class="dashboard-grid">

    <div class="dashboard-card">

        <div class="dashboard-icon">👥</div>

        <div class="dashboard-label">
            Clientes
        </div>

        <div class="dashboard-value">
            —
        </div>

        <div class="dashboard-description">
            Cadastro de clientes
        </div>

    </div>

    <div class="dashboard-card">

        <div class="dashboard-icon">📦</div>

        <div class="dashboard-label">
            Produtos
        </div>

        <div class="dashboard-value">
            —
        </div>

        <div class="dashboard-description">
            Cadastro de produtos
        </div>

    </div>

    <div class="dashboard-card">

        <div class="dashboard-icon">🛒</div>

        <div class="dashboard-label">
            Vendas
        </div>

        <div class="dashboard-value">
            —
        </div>

        <div class="dashboard-description">
            Movimentações comerciais
        </div>

    </div>

    @if (podeGerenciarUsuarios) {
        <div class="dashboard-card">

            <div class="dashboard-icon">🛡️</div>

            <div class="dashboard-label">
                Usuários
            </div>

            <div class="dashboard-value">
                —
            </div>

            <div class="dashboard-description">
                Administração de usuários
            </div>

        </div>
    }

</div>

<div class="content-card">

    <h2>
        Informações do sistema
    </h2>

    <hr />

    <div class="table-responsive">

        <table class="table table-borderless mb-0">

            <tbody>

                <tr>
                    <th>Aplicação</th>
                    <td>EstudosCSharp</td>
                </tr>

                <tr>
                    <th>Versão</th>
                    <td>1.0</td>
                </tr>

                <tr>
                    <th>Tecnologia</th>
                    <td>ASP.NET Core Razor Pages</td>
                </tr>

                <tr>
                    <th>Framework</th>
                    <td>.NET 9.0</td>
                </tr>

                <tr>
                    <th>Banco de dados</th>
                    <td>SQL Server Express</td>
                </tr>

                <tr>
                    <th>Usuário conectado</th>
                    <td>@Model.NomeUsuario</td>
                </tr>

                <tr>
                    <th>Login</th>
                    <td>@Model.LoginUsuario</td>
                </tr>

                <tr>
                    <th>Perfil</th>
                    <td>@Model.PerfilUsuario</td>
                </tr>

                <tr>
                    <th>Autenticação</th>
                    <td>

                        <span class="badge bg-success">
                            Autenticado
                        </span>

                    </td>
                </tr>

            </tbody>

        </table>

    </div>

</div>