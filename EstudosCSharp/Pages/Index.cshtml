@page
@model EstudosCSharp.Pages.IndexModel

@{
    ViewData["Title"] = "Página Inicial";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header bg-dark text-white">

            <h4 class="mb-0">
                Loja de Calçados
            </h4>

        </div>

        <div class="card-body">

            <h2>
                Bem-vindo, @Model.NomeUsuario!
            </h2>

            <p class="text-muted">
                Você está autenticado no sistema.
            </p>

            <hr />

            <h5>Informações da autenticação</h5>

            <table class="table table-bordered">

                <tbody>

                    <tr>
                        <th>ID do usuário</th>
                        <td>@Model.ID_Usuario</td>
                    </tr>

                    <tr>
                        <th>Nome</th>
                        <td>@Model.NomeUsuario</td>
                    </tr>

                    <tr>
                        <th>Login</th>
                        <td>@Model.LoginUsuario</td>
                    </tr>

                    <tr>
                        <th>Perfil</th>
                        <td>@Model.TipoUsuario</td>
                    </tr>

                    <tr>
                        <th>Autenticação</th>
                        <td>
                            <span class="badge bg-success">
                                Autenticado
                            </span>
                        </td>
                    </tr>

                </tbody>

            </table>

            <form method="post"
                  asp-page="/Conta/Logout">

                <button type="submit"
                        class="btn btn-danger">

                    Sair do sistema

                </button>

            </form>

        </div>

    </div>

</div>