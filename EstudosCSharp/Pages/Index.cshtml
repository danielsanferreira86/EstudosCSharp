@page
@model EstudosCSharp.Pages.IndexModel

@using EstudosCSharp.Security
@using Microsoft.AspNetCore.Authorization

@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Dashboard";

    var podeGerenciarUsuarios =
        (await AuthorizationService.AuthorizeAsync(
            User,
            Permissoes.GerenciarUsuarios)).Succeeded;
}

<h1 class="page-title">
    Dashboard
</h1>

<p class="page-subtitle">

    Bem-vindo, @Model.NomeUsuario!

</p>

<div class="dashboard-grid">

    <div class="dashboard-card">

        <div class="dashboard-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-3a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v3 M9 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8 M17 4a4 4 0 0 1 0 7 M22 21v-3a4 4 0 0 0-3-4" /></svg></div>

        <div class="dashboard-label">
            Clientes
        </div>

        <div class="dashboard-value">
            —
        </div>

        <div class="dashboard-description">
            Cadastro de clientes
        </div>

    </div>

    <div class="dashboard-card">

        <div class="dashboard-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 16v-5l3-6h12l3 6v5H3z M3 16v3 M21 16v3 M3 11h18 M7 14h1 M16 14h1" /></svg></div>

        <div class="dashboard-label">
            Veículos
        </div>

        <div class="dashboard-value">
            —
        </div>

        <div class="dashboard-description">
            Cadastro de veículos
        </div>

    </div>

    <div class="dashboard-card">

        <div class="dashboard-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3h2l3 12h11l2-8H6 M9 19h1 M18 19h1" /></svg></div>

        <div class="dashboard-label">
            Vendas
        </div>

        <div class="dashboard-value">
            —
        </div>

        <div class="dashboard-description">
            Movimentações comerciais
        </div>

    </div>

    @if (podeGerenciarUsuarios) {
        <div class="dashboard-card">

            <div class="dashboard-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 3 6v6c0 5 9 10 9 10s9-5 9-10V6z M8 12l3 3 5-6" /></svg></div>

            <div class="dashboard-label">
                Usuários
            </div>

            <div class="dashboard-value">
                —
            </div>

            <div class="dashboard-description">
                Administração de usuários
            </div>

        </div>
    }

</div>

<div class="content-card">

    <h2>
        Informações do sistema
    </h2>

    <hr />

    <div class="table-responsive">

        <table class="table table-borderless mb-0">

            <tbody>

                <tr>
                    <th>Aplicação</th>
                    <td>AutoCore-DMS</td>
                </tr>

                <tr>
                    <th>Versão</th>
                    <td>@Model.VersaoAplicacao</td>
                </tr>

                <tr>
                    <th>Tecnologia</th>
                    <td>ASP.NET Core Razor Pages</td>
                </tr>

                <tr>
                    <th>Framework</th>
                    <td>@Model.FrameworkAplicacao</td>
                </tr>

                <tr>
                    <th>Banco de dados</th>
                    <td>SQL Server Express</td>
                </tr>

                <tr>
                    <th>Usuário conectado</th>
                    <td>@Model.NomeUsuario</td>
                </tr>

                <tr>
                    <th>Login</th>
                    <td>@Model.LoginUsuario</td>
                </tr>

                <tr>
                    <th>Perfil</th>
                    <td>@Model.PerfilUsuario</td>
                </tr>

                <tr>
                    <th>Autenticação</th>
                    <td>

                        <span class="badge bg-success">
                            Autenticado
                        </span>

                    </td>
                </tr>

            </tbody>

        </table>

    </div>

</div>