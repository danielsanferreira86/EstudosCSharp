@page
@model EstudosCSharp.Pages.Cadastros.Estados.CreateModel

@{
    ViewData["Title"] = "Novo estado";
}

<!-- CAMINHO DE NAVEGAÇÃO -->
<div class="cad-breadcrumb">

    Cadastros / Estados / Novo estado

</div>

<!-- CABEÇALHO -->
<div class="cad-header">

    <div>

        <h1 class="cad-title">
            Novo estado
        </h1>

        <p class="cad-subtitle">
            Preencha as informações para cadastrar
            uma unidade federativa.
        </p>

    </div>

</div>

<!-- FORMULÁRIO -->
<form method="post"
      id="formEstado"
      class="cad-form"
      data-ibge-url="@Url.Page("./Create", "ConsultarIbge")">

    <div class="cad-card">

        <!-- CABEÇALHO DO FORMULÁRIO -->
        <div class="cad-form-header">

            <h2 class="cad-form-title">
                Dados do estado
            </h2>

            <p class="cad-form-subtitle">
                Informações de identificação
                da unidade federativa.
            </p>

        </div>

        <!-- CORPO DO FORMULÁRIO -->
        <div class="cad-form-body">

            <!-- ERROS GERAIS -->
            <div asp-validation-summary="ModelOnly"
                 class="cad-validation-summary">
            </div>

            <!-- CAMPOS COMPARTILHADOS -->
            <partial name="_Formulario"
                     for="Estado" />

            <!-- CAMPOS OBRIGATÓRIOS -->
            <div class="cad-form-info">

                Os campos identificados com
                <span class="cad-required">*</span>
                são obrigatórios.

            </div>

        </div>

        <!-- RODAPÉ DO FORMULÁRIO -->
        <div class="cad-form-footer">

            <a asp-page="./Index"
               class="cad-btn cad-btn-secondary">

                Cancelar

            </a>

            <button type="submit"
                    id="btnSalvarEstado"
                    class="cad-btn cad-btn-primary"
                    disabled>

                Salvar estado

            </button>

        </div>

    </div>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/cadastros/estados.js"
            asp-append-version="true">
    </script>
}