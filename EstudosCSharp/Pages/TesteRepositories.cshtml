@page
@model EstudosCSharp.Pages.TesteRepositoriesModel

@{
    ViewData["Title"] = "Teste dos Repositories";
}

<div class="container mt-4">

    <h2>Teste dos Repositories</h2>

    <p>Consulta de registros reais do SQL Server.</p>

    <div class="row mb-4">

        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5>Estados</h5>
                    <h2>@Model.Estados.Count</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5>Cidades</h5>
                    <h2>@Model.Cidades.Count</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5>Usuários</h5>
                    <h2>@Model.Usuarios.Count</h2>
                </div>
            </div>
        </div>

    </div>

    <h4>Estados cadastrados</h4>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>UF</th>
                <th>IBGE</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var estado in Model.Estados) {
                <tr>
                    <td>@estado.ID</td>
                    <td>@estado.Nome</td>
                    <td>@estado.UF</td>
                    <td>@estado.Codigo_IBGE</td>
                </tr>
            }
        </tbody>
    </table>

    <h4 class="mt-4">Cidades cadastradas</h4>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>IBGE</th>
                <th>Estado</th>
                <th>UF</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var cidade in Model.Cidades) {
                <tr>
                    <td>@cidade.ID</td>
                    <td>@cidade.Nome</td>
                    <td>@cidade.Codigo_IBGE</td>
                    <td>@(cidade.Estado?.Nome)</td>
                    <td>@(cidade.Estado?.UF)</td>
                </tr>
            }
        </tbody>
    </table>

    <h4 class="mt-4">Usuários cadastrados</h4>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Login</th>
                <th>Tipo</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var usuario in Model.Usuarios) {
                <tr>
                    <td>@usuario.ID</td>
                    <td>@usuario.Nome</td>
                    <td>@usuario.Login</td>
                    <td>@usuario.Tipo_Usuario</td>
                    <td>
                        @if (usuario.Ativo) {
                            <span class="badge bg-success">
                                Ativo
                            </span>
                        } else {
                            <span class="badge bg-danger">
                                Inativo
                            </span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>